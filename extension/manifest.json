{
  "manifest_version": 3,
  "name": "Go Through Tabs",
  "version": "1.1.1",
  "description": "Cmd + [ закрывает вкладку у начала её истории; Cmd + ] восстанавливает её рядом с исходной вкладкой.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["tabs", "webNavigation", "sessions", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "action": {
    "default_title": "Go Through Tabs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
